<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="ordering"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" default="0000-00-00 00:00:00" type="hidden" filter="unset"/>
    <field name="created_by" type="createdby" default="0" label="COM_ERESERVAS_FORM_LBL_LISTAESPERA_CREATED_BY" description="COM_ERESERVAS_FORM_DESC_LISTAESPERA_CREATED_BY" hidden="true" hint="COM_ERESERVAS_FORM_LBL_LISTAESPERA_CREATED_BY"/>
    <field name="modified_by" type="modifiedby" default="0" label="COM_ERESERVAS_FORM_LBL_LISTAESPERA_MODIFIED_BY" description="COM_ERESERVAS_FORM_DESC_LISTAESPERA_MODIFIED_BY" hidden="true" hint="COM_ERESERVAS_FORM_LBL_LISTAESPERA_MODIFIED_BY"/>
    <field name="nombre" filter="safehtml" type="text" label="COM_ERESERVAS_FORM_LBL_LISTAESPERA_NOMBRE" description="COM_ERESERVAS_FORM_DESC_LISTAESPERA_NOMBRE" hint="COM_ERESERVAS_FORM_LBL_LISTAESPERA_NOMBRE"/>
    <field name="email" validate="email" type="email" label="COM_ERESERVAS_FORM_LBL_LISTAESPERA_EMAIL" description="COM_ERESERVAS_FORM_DESC_LISTAESPERA_EMAIL" hint="COM_ERESERVAS_FORM_LBL_LISTAESPERA_EMAIL"/>
    <field name="plazas" label="COM_ERESERVAS_FORM_LBL_LISTAESPERA_PLAZAS" description="COM_ERESERVAS_FORM_DESC_LISTAESPERA_PLAZAS" hint="COM_ERESERVAS_FORM_LBL_LISTAESPERA_PLAZAS"/>
    <field name="turno" type="list" label="COM_ERESERVAS_FORM_LBL_LISTAESPERA_TURNO" description="COM_ERESERVAS_FORM_DESC_LISTAESPERA_TURNO" hint="COM_ERESERVAS_FORM_LBL_LISTAESPERA_TURNO">
      <option value="comida">COM_ERESERVAS_LISTAESPERAS_TURNO_OPTION_COMIDA</option>
      <option value="cena">COM_ERESERVAS_LISTAESPERAS_TURNO_OPTION_CENA</option>
    </field>
    <field name="telefono" filter="int" type="text" label="COM_ERESERVAS_FORM_LBL_LISTAESPERA_TELEFONO" description="COM_ERESERVAS_FORM_DESC_LISTAESPERA_TELEFONO" hint="COM_ERESERVAS_FORM_LBL_LISTAESPERA_TELEFONO"/>
    <field name="fecha" class="inputbox" format="%Y-%m-%d" timeformat="24" filter="server_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" label="COM_ERESERVAS_FORM_LBL_LISTAESPERA_FECHA" description="COM_ERESERVAS_FORM_DESC_LISTAESPERA_FECHA" hint="COM_ERESERVAS_FORM_LBL_LISTAESPERA_FECHA"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
