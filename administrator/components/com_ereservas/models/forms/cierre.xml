<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="ordering"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" default="0000-00-00 00:00:00" type="hidden" filter="unset"/>
    <field name="created_by" type="createdby" default="0" label="COM_ERESERVAS_FORM_LBL_CIERRE_CREATED_BY" description="COM_ERESERVAS_FORM_DESC_CIERRE_CREATED_BY" hidden="true" hint="COM_ERESERVAS_FORM_LBL_CIERRE_CREATED_BY"/>
    <field name="modified_by" type="modifiedby" default="0" label="COM_ERESERVAS_FORM_LBL_CIERRE_MODIFIED_BY" description="COM_ERESERVAS_FORM_DESC_CIERRE_MODIFIED_BY" hidden="true" hint="COM_ERESERVAS_FORM_LBL_CIERRE_MODIFIED_BY"/>
    <field name="fecha_inicio" default="0000-00-00" class="inputbox" format="%Y-%m-%d" timeformat="12" filter="server_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" label="COM_ERESERVAS_FORM_LBL_CIERRE_FECHA_INICIO" description="COM_ERESERVAS_FORM_DESC_CIERRE_FECHA_INICIO" hint="COM_ERESERVAS_FORM_LBL_CIERRE_FECHA_INICIO"/>
    <field name="fecha_fin" class="inputbox" format="%Y-%m-%d" timeformat="24" filter="server_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" label="COM_ERESERVAS_FORM_LBL_CIERRE_FECHA_FIN" description="COM_ERESERVAS_FORM_DESC_CIERRE_FECHA_FIN" hint="COM_ERESERVAS_FORM_LBL_CIERRE_FECHA_FIN"/>
    <field name="concepto" filter="safehtml" type="text" label="COM_ERESERVAS_FORM_LBL_CIERRE_CONCEPTO" description="COM_ERESERVAS_FORM_DESC_CIERRE_CONCEPTO" hint="COM_ERESERVAS_FORM_LBL_CIERRE_CONCEPTO"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
