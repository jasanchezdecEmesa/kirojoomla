<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="ordering"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" default="0000-00-00 00:00:00" type="hidden" filter="unset"/>
    <field name="created_by" type="createdby" default="0" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_CREATED_BY" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_CREATED_BY" hidden="true" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_CREATED_BY"/>
    <field name="modified_by" type="modifiedby" default="0" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_MODIFIED_BY" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_MODIFIED_BY" hidden="true" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_MODIFIED_BY"/>
    <field name="id_reserva" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_ID_RESERVA" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_ID_RESERVA" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_ID_RESERVA"/>
    <field name="fecha" class="inputbox" format="%Y-%m-%d" timeformat="24" filter="server_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_FECHA" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_FECHA" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_FECHA"/>
    <field name="hora" filter="safehtml" type="text" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_HORA" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_HORA" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_HORA"/>
    <field name="email" validate="email" type="email" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_EMAIL" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_EMAIL" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_EMAIL"/>
    <field name="nombre" filter="safehtml" type="text" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_NOMBRE" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_NOMBRE" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_NOMBRE"/>
    <field name="plazas" filter="int" type="text" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_PLAZAS" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_PLAZAS" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_PLAZAS"/>
    <field name="total" type="checkbox" checked="" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_TOTAL" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_TOTAL" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_TOTAL"/>
    <field name="telefono" filter="safehtml" type="text" label="COM_ERESERVAS_FORM_LBL_CANCELACIONE_TELEFONO" description="COM_ERESERVAS_FORM_DESC_CANCELACIONE_TELEFONO" hint="COM_ERESERVAS_FORM_LBL_CANCELACIONE_TELEFONO"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
