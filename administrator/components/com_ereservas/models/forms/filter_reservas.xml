<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_ERESERVAS_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_ERESERVAS_FILTER_STATE"
               description="COM_ERESERVAS_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field name="id_visita" type="sql" label="COM_ERESERVAS_FORM_LBL_RESERVA_ID_VISITA" query="SELECT '' AS `id`, 'COM_ERESERVAS_RESERVAS_ID_VISITA_FILTER' AS `val` UNION SELECT `id` AS `id`,  CONCAT(`nombre`, ' ', `fecha`, ' ', `hora_inicio`) AS val FROM `#__ereservas_visita`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>
<field name="id_idioma" type="sql" label="COM_ERESERVAS_FORM_LBL_RESERVA_ID_IDIOMA" query="SELECT '' AS `id`, 'COM_ERESERVAS_RESERVAS_ID_IDIOMA_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_idioma`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>
<field name="id_usuario" type="sql" label="COM_ERESERVAS_FORM_LBL_RESERVA_ID_USUARIO" query="SELECT '' AS `id`, 'COM_ERESERVAS_RESERVAS_ID_USUARIO_FILTER' AS `val` UNION SELECT `id` AS `id`, `name` AS val FROM `#__users`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>
<field name="id_pais" type="sql" label="COM_ERESERVAS_FORM_LBL_RESERVA_ID_PAIS" query="SELECT '' AS `id`, 'COM_ERESERVAS_RESERVAS_ID_PAIS_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_pais`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>
<field name="id_tipo_cliente" type="sql" label="COM_ERESERVAS_FORM_LBL_RESERVA_ID_TIPO_CLIENTE" query="SELECT '' AS `id`, 'COM_ERESERVAS_RESERVAS_ID_TIPO_CLIENTE_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_tipo_cliente`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>


    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_CONTENT_LIST_FULL_ORDERING"
               description="COM_CONTENT_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.`id` ASC">ID Ascending</option><option value="a.`id` DESC">ID Descending</option><option value="a.`ordering` ASC">Order Ascending</option><option value="a.`ordering` DESC">Order Descending</option><option value="a.`state` ASC">State Ascending</option><option value="a.`state` DESC">State Descending</option><option value="a.`nombre` ASC">Nombre Ascending</option><option value="a.`nombre` DESC">Nombre Descending</option><option value="a.`telefono` ASC">Teléfono Ascending</option><option value="a.`telefono` DESC">Teléfono Descending</option><option value="a.`email` ASC">Email Ascending</option><option value="a.`email` DESC">Email Descending</option><option value="a.`id_visita` ASC">Visita Ascending</option><option value="a.`id_visita` DESC">Visita Descending</option><option value="a.`id_idioma` ASC">Idioma Ascending</option><option value="a.`id_idioma` DESC">Idioma Descending</option><option value="a.`tarjeta` ASC">Tarjeta Ascending</option><option value="a.`tarjeta` DESC">Tarjeta Descending</option><option value="a.`pagado` ASC">Pagado Ascending</option><option value="a.`pagado` DESC">Pagado Descending</option><option value="a.`estado` ASC">Estado Ascending</option><option value="a.`estado` DESC">Estado Descending</option><option value="a.`id_usuario` ASC">Usuario Ascending</option><option value="a.`id_usuario` DESC">Usuario Descending</option><option value="a.`id_pais` ASC">Pais Ascending</option><option value="a.`id_pais` DESC">Pais Descending</option><option value="a.`cpostal` ASC">Codigo postal Ascending</option><option value="a.`cpostal` DESC">Codigo postal Descending</option><option value="a.`observaciones` ASC">Observaciones Ascending</option><option value="a.`observaciones` DESC">Observaciones Descending</option><option value="a.`id_tipo_cliente` ASC">Tipo Cliente Ascending</option><option value="a.`id_tipo_cliente` DESC">Tipo Cliente Descending</option><option value="a.`referencia` ASC">Referencia Ascending</option><option value="a.`referencia` DESC">Referencia Descending</option><option value="a.`vinos` ASC">Vinos Ascending</option><option value="a.`vinos` DESC">Vinos Descending</option><option value="a.`tipo_cata` ASC">Tipo Cata Ascending</option><option value="a.`tipo_cata` DESC">Tipo Cata Descending</option><option value="a.`aperitivo` ASC">Aperitivo Ascending</option><option value="a.`aperitivo` DESC">Aperitivo Descending</option><option value="a.`alergenos` ASC">Alergenos Ascending</option><option value="a.`alergenos` DESC">Alergenos Descending</option><option value="a.`menu_especial` ASC">Menu Especial Ascending</option><option value="a.`menu_especial` DESC">Menu Especial Descending</option><option value="a.`asistencia` ASC">Asistencia Ascending</option><option value="a.`asistencia` DESC">Asistencia Descending</option>

        </field>

        <field name="limit"
               type="limitbox"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>