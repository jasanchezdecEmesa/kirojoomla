<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_ERESERVAS_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_ERESERVAS_FILTER_STATE"
               description="COM_ERESERVAS_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field name="dia_semana" label="COM_ERESERVAS_FORM_LBL_SERVICIOSEMANAL_DIA_SEMANA" type="list" onchange="this.form.submit();" default="COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_FILTER">
  <option value="">COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_FILTER</option>
  <option value="1">COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_OPTION_1</option>
  <option value="2">COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_OPTION_2</option>
  <option value="3">COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_OPTION_3</option>
  <option value="4">COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_OPTION_4</option>
  <option value="5">COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_OPTION_5</option>
  <option value="6">COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_OPTION_6</option>
  <option value="7">COM_ERESERVAS_SERVICIOSEMANALES_DIA_SEMANA_OPTION_7</option>
</field>


    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_CONTENT_LIST_FULL_ORDERING"
               description="COM_CONTENT_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.`id` ASC">ID Ascending</option><option value="a.`id` DESC">ID Descending</option><option value="a.`ordering` ASC">Order Ascending</option><option value="a.`ordering` DESC">Order Descending</option><option value="a.`state` ASC">State Ascending</option><option value="a.`state` DESC">State Descending</option><option value="a.`dia_semana` ASC">Dia Semana Ascending</option><option value="a.`dia_semana` DESC">Dia Semana Descending</option><option value="a.`hora` ASC">Hora Ascending</option><option value="a.`hora` DESC">Hora Descending</option><option value="a.`aforo` ASC">Aforo Ascending</option><option value="a.`aforo` DESC">Aforo Descending</option>

        </field>

        <field name="limit"
               type="limitbox"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>