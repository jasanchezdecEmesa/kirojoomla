<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_ERESERVAS_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_ERESERVAS_FILTER_STATE"
               description="COM_ERESERVAS_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field name="id_sala" type="sql" label="COM_ERESERVAS_FORM_LBL_TIPOVISITA_ID_SALA" query="SELECT '' AS `id`, 'COM_ERESERVAS_TIPOVISITAS_ID_SALA_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_sala`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>


    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_CONTENT_LIST_FULL_ORDERING"
               description="COM_CONTENT_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.`id` ASC">ID Ascending</option><option value="a.`id` DESC">ID Descending</option><option value="a.`ordering` ASC">Order Ascending</option><option value="a.`ordering` DESC">Order Descending</option><option value="a.`state` ASC">State Ascending</option><option value="a.`state` DESC">State Descending</option><option value="a.`nombre` ASC">Nombre Ascending</option><option value="a.`nombre` DESC">Nombre Descending</option><option value="a.`imagen` ASC">Imagen Ascending</option><option value="a.`imagen` DESC">Imagen Descending</option><option value="a.`aforo_web` ASC">Aforo Web Ascending</option><option value="a.`aforo_web` DESC">Aforo Web Descending</option><option value="a.`aforo_privado` ASC">Aforo Privado Ascending</option><option value="a.`aforo_privado` DESC">Aforo Privado Descending</option><option value="a.`comida` ASC">Comida Ascending</option><option value="a.`comida` DESC">Comida Descending</option><option value="a.`cata` ASC">Cata Ascending</option><option value="a.`cata` DESC">Cata Descending</option><option value="a.`id_sala` ASC">Sala Ascending</option><option value="a.`id_sala` DESC">Sala Descending</option><option value="a.`observaciones` ASC">Observaciones Ascending</option><option value="a.`observaciones` DESC">Observaciones Descending</option><option value="a.`precio` ASC">Precio Ascending</option><option value="a.`precio` DESC">Precio Descending</option><option value="a.`descripcion` ASC">Descripcion Ascending</option><option value="a.`descripcion` DESC">Descripcion Descending</option>

        </field>

        <field name="limit"
               type="limitbox"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>