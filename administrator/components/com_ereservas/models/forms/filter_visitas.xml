<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" hint="COM_ERESERVAS_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_ERESERVAS_FILTER_STATE"
               description="COM_ERESERVAS_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field name="id_sala" type="sql" label="COM_ERESERVAS_FORM_LBL_VISITA_ID_SALA" query="SELECT '' AS `id`, 'COM_ERESERVAS_VISITAS_ID_SALA_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_sala`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>
<field name="fecha.from" label="COM_ERESERVAS_VISITAS_FECHA_FILTER_FROM" type="calendar" onchange="this.form.submit();" filter="safehtml" class="inputbox" showtime="false" translateformat="false" hint="COM_ERESERVAS_VISITAS_FECHA_FILTER_FROM"/>
<field name="fecha.to" label="COM_ERESERVAS_VISITAS_FECHA_FILTER_TO" type="calendar" onchange="this.form.submit();" filter="safehtml" class="inputbox" showtime="false" translateformat="false" hint="COM_ERESERVAS_VISITAS_FECHA_FILTER_TO"/>
<field name="idioma" type="sql" label="COM_ERESERVAS_FORM_LBL_VISITA_IDIOMA" query="SELECT '' AS `id`, 'COM_ERESERVAS_VISITAS_IDIOMA_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_idioma`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>
<field name="id_tipo_visita" type="sql" label="COM_ERESERVAS_FORM_LBL_VISITA_ID_TIPO_VISITA" query="SELECT '' AS `id`, 'COM_ERESERVAS_VISITAS_ID_TIPO_VISITA_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_tipo_visita`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>
<field name="guia" type="sql" label="COM_ERESERVAS_FORM_LBL_VISITA_GUIA" query="SELECT '' AS `id`, 'COM_ERESERVAS_VISITAS_GUIA_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_guias`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>


    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_CONTENT_LIST_FULL_ORDERING"
               description="COM_CONTENT_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.`id` ASC">ID Ascending</option><option value="a.`id` DESC">ID Descending</option><option value="a.`ordering` ASC">Order Ascending</option><option value="a.`ordering` DESC">Order Descending</option><option value="a.`state` ASC">State Ascending</option><option value="a.`state` DESC">State Descending</option><option value="a.`nombre` ASC">Nombre Ascending</option><option value="a.`nombre` DESC">Nombre Descending</option><option value="a.`id_sala` ASC">Sala Ascending</option><option value="a.`id_sala` DESC">Sala Descending</option><option value="a.`aforo_web` ASC">Aforo Web Ascending</option><option value="a.`aforo_web` DESC">Aforo Web Descending</option><option value="a.`aforo_privado` ASC">Aforo Privado Ascending</option><option value="a.`aforo_privado` DESC">Aforo Privado Descending</option><option value="a.`comida` ASC">Comida Ascending</option><option value="a.`comida` DESC">Comida Descending</option><option value="a.`cata` ASC">Cata Ascending</option><option value="a.`cata` DESC">Cata Descending</option><option value="a.`observaciones` ASC">Observaciones Ascending</option><option value="a.`observaciones` DESC">Observaciones Descending</option><option value="a.`precio` ASC">Precio Ascending</option><option value="a.`precio` DESC">Precio Descending</option><option value="a.`fecha` ASC">Fecha Ascending</option><option value="a.`fecha` DESC">Fecha Descending</option><option value="a.`hora_inicio` ASC">Hora inicio Ascending</option><option value="a.`hora_inicio` DESC">Hora inicio Descending</option><option value="a.`hora_fin` ASC">Hora Fin Ascending</option><option value="a.`hora_fin` DESC">Hora Fin Descending</option><option value="a.`idioma` ASC">Idioma Ascending</option><option value="a.`idioma` DESC">Idioma Descending</option><option value="a.`id_tipo_visita` ASC">Tipo Visita Ascending</option><option value="a.`id_tipo_visita` DESC">Tipo Visita Descending</option><option value="a.`aforo_ocupado` ASC">Aforo Ocupado Ascending</option><option value="a.`aforo_ocupado` DESC">Aforo Ocupado Descending</option><option value="a.`guia` ASC">Guia Ascending</option><option value="a.`guia` DESC">Guia Descending</option>

        </field>

        <field name="limit"
               type="limitbox"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>