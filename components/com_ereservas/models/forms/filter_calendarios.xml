               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="fecha_inicio.from" label="COM_ERESERVAS_CALENDARIOS_FECHA_INICIO_FILTER_FROM" type="calendar" onchange="this.form.submit();" filter="safehtml" class="inputbox" showtime="false" translateformat="false" hint="COM_ERESERVAS_CALENDARIOS_FECHA_INICIO_FILTER_FROM"/>
<field name="fecha_inicio.to" label="COM_ERESERVAS_CALENDARIOS_FECHA_INICIO_FILTER_TO" type="calendar" onchange="this.form.submit();" filter="safehtml" class="inputbox" showtime="false" translateformat="false" hint="COM_ERESERVAS_CALENDARIOS_FECHA_INICIO_FILTER_TO"/>
<field name="fecha_fin.from" label="COM_ERESERVAS_CALENDARIOS_FECHA_FIN_FILTER_FROM" type="calendar" onchange="this.form.submit();" filter="safehtml" class="inputbox" showtime="false" translateformat="false" hint="COM_ERESERVAS_CALENDARIOS_FECHA_FIN_FILTER_FROM"/>
<field name="fecha_fin.to" label="COM_ERESERVAS_CALENDARIOS_FECHA_FIN_FILTER_TO" type="calendar" onchange="this.form.submit();" filter="safehtml" class="inputbox" showtime="false" translateformat="false" hint="COM_ERESERVAS_CALENDARIOS_FECHA_FIN_FILTER_TO"/>
<field name="id_tipo_visita" type="sql" label="COM_ERESERVAS_FORM_LBL_CALENDARIO_ID_TIPO_VISITA" query="SELECT '' AS `id`, 'COM_ERESERVAS_CALENDARIOS_ID_TIPO_VISITA_FILTER' AS `val` UNION SELECT `id` AS `id`, `nombre` AS val FROM `#__ereservas_tipo_visita`" key_field="id" value_field="val" class="inputbox" onchange="this.form.submit()" translate="true"/>
<field name="frecuencia" label="COM_ERESERVAS_FORM_LBL_CALENDARIO_FRECUENCIA" type="list" onchange="this.form.submit();" default="COM_ERESERVAS_CALENDARIOS_FRECUENCIA_FILTER">
  <option value="">COM_ERESERVAS_CALENDARIOS_FRECUENCIA_FILTER</option>
  <option value="diaria">COM_ERESERVAS_CALENDARIOS_FRECUENCIA_OPTION_DIARIA</option>
  <option value="mensual">COM_ERESERVAS_CALENDARIOS_FRECUENCIA_OPTION_MENSUAL</option>
</field>


    </fields>
