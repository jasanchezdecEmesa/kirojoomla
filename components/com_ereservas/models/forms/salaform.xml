<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="ordering"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" default="0000-00-00 00:00:00" type="hidden" filter="unset"/>
    <field name="nombre" filter="safehtml" type="text" required="true" message="Rellene el campo nombre" label="COM_ERESERVAS_FORM_LBL_SALA_NOMBRE" description="COM_ERESERVAS_FORM_DESC_SALA_NOMBRE" hint="COM_ERESERVAS_FORM_LBL_SALA_NOMBRE"/>
    <field name="aforo_web" filter="safehtml" type="number" required="true" message="Rellene el campo aforo web" label="COM_ERESERVAS_FORM_LBL_SALA_AFORO_WEB" description="COM_ERESERVAS_FORM_DESC_SALA_AFORO_WEB" hint="COM_ERESERVAS_FORM_LBL_SALA_AFORO_WEB"/>
    <field name="aforo_privado" filter="safehtml" type="number" label="COM_ERESERVAS_FORM_LBL_SALA_AFORO_PRIVADO" description="COM_ERESERVAS_FORM_DESC_SALA_AFORO_PRIVADO" hint="COM_ERESERVAS_FORM_LBL_SALA_AFORO_PRIVADO"/>
    <field name="observaciones" filter="safehtml" type="textarea" label="COM_ERESERVAS_FORM_LBL_SALA_OBSERVACIONES" description="COM_ERESERVAS_FORM_DESC_SALA_OBSERVACIONES" hint="COM_ERESERVAS_FORM_LBL_SALA_OBSERVACIONES"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
